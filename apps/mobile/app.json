{
  "expo": {
    "name": "הנדיל",
    "slug": "handil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F2226"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.handil.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFC629"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.handil.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "lang": "he",
      "backgroundColor": "#F0EEE9",
      "title": "הנדיל — שוק בעלי מקצוע"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "הנדיל צריכה גישה לתמונות כדי לצרף תמונות לעבודה שאתם מפרסמים ולעדכן את תמונת הפרופיל.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c32124fe-088d-44ea-a23a-2745a3e2393d"
      }
    },
    "owner": "shmuelgo"
  }
}
